/* Version resource for the fixture exe, so its MSI File row carries a
   File.Version like real-world payloads; `just fixtures` passes VERSION_NUM
   (comma-separated) and VERSION (quoted string). */
#ifndef VERSION_NUM
#define VERSION_NUM 0,0,0,0
#define VERSION "0.0.0"
#endif

1 VERSIONINFO
FILEVERSION VERSION_NUM
PRODUCTVERSION VERSION_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Embala Hello"
      VALUE "FileVersion", VERSION
      VALUE "ProductName", "Embala Hello"
      VALUE "ProductVersion", VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
