-- installer by editing [setup] in embala.toml and rebuilding, or ship a raw
-- script via [setup].script.
-- Package: hello 0.1.0 (ca.hrndz.embala.hello)

local pkg = embala.package

embala.ui.page{ kind = "welcome", title = pkg.display_name, body = pkg.description }

embala.ui.page{ kind = "license", must_accept = true, text = "Embala Hello — Test Fixture License\n\nPermission is granted to poke at this fixture for testing purposes.\nProvided \"as is\", without warranty of any kind.\n" }

embala.ui.page{ kind = "directory", default = embala.install_dir, allow_change = true }

embala.ui.page{
  kind = "components",
  items = {
    { id = "docs", label = "Documentation", description = "Offline readme", default = true },
  },
}

-- Payload files (always installed).
embala.fs.copy("hello.exe", "hello.exe")

-- Component "docs" (installed when selected).
if embala.ui.selected("docs") then
  embala.fs.copy("readme.txt", "readme.txt")
end

-- Start-menu shortcut for the main executable.
embala.shortcut.create{ name = pkg.display_name, target = "hello.exe", location = "start-menu", description = pkg.description }

-- Add/Remove Programs registration.
embala.arp.register{
  display_name = pkg.display_name,
  version = pkg.version,
  publisher = pkg.publisher,
  install_location = embala.install_dir,
  uninstall_string = '"' .. embala.install_dir .. '\\uninstall.exe"',
  display_icon = embala.install_dir .. '\\' .. "hello.exe",
}

embala.ui.page{ kind = "finish", run = { target = "hello.exe" } }
